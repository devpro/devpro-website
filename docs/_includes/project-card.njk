        {% elseif tech == "Terraform" %}
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" fill="currentColor" aria-hidden="true">
          <title>Terraform</title>
          <path d="M1.44 0v7.575l6.561 3.79V3.787zm21.12 4.227l-6.561 3.791v7.574l6.56-3.787zM8.72 4.23v7.575l6.561 3.787V8.018zm0 8.405v7.575L15.28 24v-7.578z"/>
        </svg>
        {% endif %}
      </span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</article>
