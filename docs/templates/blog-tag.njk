---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
eleventyComputed:
  title: Posts about {{ tag }}
permalink: /tags/{{ tag | slugify }}/index.html
section:
  title: "Blog"
  url: "/blog"
---

{%- set postsWithTag = collections[tag] %}
{%- if postsWithTag.length %}
  {%- for post in postsWithTag | reverse %}
    <a href="{{ post.url }}">
      <article>
        <p><strong>{{ post.data.title }}</strong></p>
        <p>Published on <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
        {%- if post.data.page.excerpt -%}
        <p><small>{{ post.data.page.excerpt | toHtml | safe }}</small></p>
        {%- endif -%}
      </article>
    </a>
  {%- endfor %}
{%- else %}
  <p>No posts found about {{ tag }}.</p>
{%- endif %}
