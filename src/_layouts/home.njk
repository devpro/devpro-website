---
layout: base
---

<div class="welcome">
  {{ content | safe }}
</div>

<div class="grid">
  <div>
    <h2>Recent blog posts</h2>
    <div>
      {%- for post in collections.posts | reverse | first(3) %}
      <div>
        <div>
          <small><time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></small>
        </div>
        <div>
          <a href="{{ post.url }}">{{ post.data.title }}</a></time>
          {%- if post.data.page.excerpt -%}
          <p><small>{{ post.data.page.excerpt | trim | toHtml | safe}}</small></p>
          {%- endif -%}
        </div>
      </div>
      {%- endfor %}
    </div>
    <p><a href="/blog">All posts</a></p>
  </div>
  <div>
    <h2>Latest news</h2>
    <div>
      {%- for news in news['2025'] | reverse | first(3) %}
      <div>
        <div>
          <small><time datetime="{{ news.date | htmlDateString }}">{{ news.date | readableDate }}</time></small>
        </div>
        <div>
          <a href="{{ news.link }}" target="_blank">{{ news.title }}</a>
          <p><small>{{ news.description | toHtml | safe }}</small></p>
        </div>
      </div>
      {%- endfor %}
    </div>
    <p><a href="/news/2025">All news</a></p>
  </div>
</div>
