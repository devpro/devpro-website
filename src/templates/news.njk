---
title: News
permalink: /news/index.html
---
{%- for year in years | reverse %}
{%- set newsInYear = news[year] %}
{%- if newsInYear.length %}
<h3>{{ year }}</h3>
<div>
  {%- for news in newsInYear | reverse %}
  <div>
    <div>
      <time datetime="{{ news.date | htmlDateString }}">{{ news.date | readableDate }}</time>
    </div>
    <div>
      <h4><a href="{{ news.link }}" target="_blank">{{ news.title }}</a></h4>
      <p>{{ news.description | toHtml | safe }}</p>
    </div>
  </div>
  {%- endfor %}
</div>
{%- endif %}
{%- endfor %}
